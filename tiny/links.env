# Where ego tiny's project links and installers point.
#
# tiny/rebrand-links.sh rewrites the upstream sources with these values after
# every upstream merge, and tiny/patch_app.py uses EGO_TINY_SITE for the links
# inside the app's web UI. Change a value here, then run tiny/apply-overlay.sh
# (and tiny/build-tiny.sh --install for the app) to apply it everywhere.

# Project website: replaces lite.ego.app, paths kept (/privacy, /terms, /document/...).
EGO_TINY_SITE=https://ego.octol.ing

# Installer DMG (Apple Silicon only; ego tiny has no Intel or Windows build).
# Replaces the cdn.ego.app setup downloads. tiny/package-dmg.sh builds the file.
EGO_TINY_DOWNLOAD=https://ego.octol.ing/download/ego-tiny-arm64.dmg

# Source repository (GitHub owner/name): replaces citrolabs/ego-lite.
EGO_TINY_REPO=dev-jelly/ego-tiny

# Maintainer shown in plugin and marketplace manifests: replaces citrolabs.
EGO_TINY_OWNER=dev-jelly
EGO_TINY_CONTACT=57338457+dev-jelly@users.noreply.github.com
